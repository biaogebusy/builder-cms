<?php

/**
 * @file
 * Contains paragraphs_type_permissions.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\paragraphs_type_permissions\Hook\ParagraphsTypePermissionsHooks;
use Drupal\Core\Session\AccountInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function paragraphs_type_permissions_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(ParagraphsTypePermissionsHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_ENTITY_TYPE_access() for entity type "paragraph".
 */
#[LegacyHook]
function paragraphs_type_permissions_paragraph_access(ParagraphInterface $entity, $operation, AccountInterface $account) {
  return \Drupal::service(ParagraphsTypePermissionsHooks::class)->paragraphAccess($entity, $operation, $account);
}

/**
 * Implements hook_ENTITY_TYPE_create_access() for entity type "paragraph".
 */
#[LegacyHook]
function paragraphs_type_permissions_paragraph_create_access(?AccountInterface $account = NULL, array $context = [], $entity_bundle = NULL) {
  return \Drupal::service(ParagraphsTypePermissionsHooks::class)->paragraphCreateAccess($account, $context, $entity_bundle);
}
