<?php

/**
 * @file
 * Schema for immutable AI usage facts and purchasing cost rating (UB1.1 / UB1.4 / UB1.5).
 *
 * The tables live in their own module so uninstalling the task runner
 * (xinshi_ai) never drops financial facts.
 */

declare(strict_types=1);

use Drupal\Core\Database\Connection;
use Drupal\Core\Utility\UpdateException;

/**
 * Implements hook_schema().
 */
function xinshi_ai_usage_schema(): array {
  $schema['ai_usage_event'] = [
    'description' => 'Append-only usage events received from registered producers.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'producer_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'event_id' => ['type' => 'varchar_ascii', 'length' => 191, 'not null' => TRUE],
      'event_type' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'schema_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'operation_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'observation_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'payload_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // Milliseconds since the Unix epoch, UTC; the same precision the Node producer uses.
      'occurred_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'received_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      // NULL until the aggregation consumer (UB1.6) has applied the event.
      'processed_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      // Consumer bookkeeping: repeated failures quarantine the event so it stops
      // blocking the batch; the fact itself is never modified.
      'failure_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_error' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'quarantined_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'payload_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'dedup' => ['site_id', 'producer_id', 'event_id'],
      'attempt_revision' => ['site_id', 'attempt_id', 'event_type', 'observation_revision'],
    ],
    'indexes' => [
      'attempt' => ['site_id', 'attempt_id', 'event_type', 'observation_revision'],
      'operation' => ['site_id', 'operation_id'],
      'pending' => ['processed_at', 'quarantined_at', 'id'],
    ],
  ];

  $schema['ai_price_book_version'] = [
    'description' => 'Versioned purchasing price books. Active version supplies rates for cost rating.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'book_kind' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE,
        'description' => 'E.g. supplier_chat; different kinds have different rate structures.'],
      'version' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE,
        'description' => 'Human-readable version label, unique per site + kind.'],
      'currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => TRUE,
        'description' => 'ISO 4217 code, e.g. CNY, USD.'],
      'rates_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Structured rates keyed by provider account ref and model id.'],
      'rounding_policy' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => 'half_up',
        'description' => 'Rounding applied when converting token * per-million rate to micros.'],
      'status' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => 'draft',
        'description' => 'draft or active; only one active version per site + kind at a time.'],
      'source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE,
        'description' => 'Optional reference to supplier quote, invoice or contract.'],
      'effective_from' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Milliseconds since epoch; cost rating matches by attempt occurred_at.'],
      'effective_to' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'NULL means open-ended; new version replaces active atomically.'],
      'created_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'created_by' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'version' => ['site_id', 'book_kind', 'version'],
    ],
    'indexes' => [
      'active' => ['site_id', 'book_kind', 'status', 'effective_from'],
    ],
  ];

  $schema['ai_usage_cost_entry'] = [
    'description' => 'Supplier cost computed for one observed attempt revision. Append-only.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'observation_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'price_version_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE,
        'description' => 'NULL when valuation_state is unpriced.'],
      'currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => FALSE],
      'input_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'cache_read_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'cache_write_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'output_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'image_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'Per-image component of an image attempt (supplier_image book); NULL for chat attempts.'],
      'total_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'valuation_state' => ['type' => 'varchar_ascii', 'length' => 24, 'not null' => TRUE,
        'description' => 'unpriced, rated_estimate, reconciled. Unpriced means no matching rate was found.'],
      'unpriced_reason' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE,
        'description' => 'Short code explaining why cost is unpriced, e.g. unknown_model.'],
      'source_kind' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE, 'default' => 'price_book',
        'description' => 'price_book or supplier_reconciliation.'],
      'computed_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'attempt_revision' => ['site_id', 'attempt_id', 'observation_revision', 'source_kind'],
    ],
    'indexes' => [
      'operation_lookup' => ['site_id', 'attempt_id'],
      'valuation' => ['site_id', 'valuation_state'],
    ],
  ];

  $schema['ai_provider_attempt'] = [
    'description' => 'Current projection of one provider attempt, rebuilt from ai_usage_event by the consumer (UB1.6).',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'operation_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'logical_call_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_no' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'producer_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'feature' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'stage' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'payer' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
      'billing_role' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => FALSE,
        'description' => 'primary, auxiliary or repair; NULL for events recorded before UB2.1.'],
      'actor_user_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
      'billing_account_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
      'provider_account_ref' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'requested_model' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'resolved_model' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
      'model_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE,
        'description' => 'resolved_model, falling back to requested_model; the rollup model dimension.'],
      'gateway_request_id' => ['type' => 'varchar_ascii', 'length' => 191, 'not null' => FALSE],
      'provider_request_id' => ['type' => 'varchar_ascii', 'length' => 191, 'not null' => FALSE],
      'state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE,
        'description' => 'prepared, in_flight, succeeded, failed, unknown, not_sent.'],
      'dispatch_state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
      'outcome' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => FALSE],
      'error_code' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'usage_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE,
        'description' => 'Highest applied observation_revision; 0 while only prepared.'],
      'usage_quality' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => FALSE,
        'description' => 'reported, missing or invalid; NULL when no usage block was observed.'],
      'usage_json' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'input_tokens_total' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'input_tokens_cache_read' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'input_tokens_cache_write' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'output_tokens_total' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'output_tokens_reasoning' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'images_generated' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'Images the upstream returned for an image attempt (UB2.4); NULL for chat attempts.'],
      // Copy of the immutable cost entry for usage_revision, so a rollup cell is
      // a pure function of the projection rows it covers (no join at rollup time).
      'cost_valuation_state' => ['type' => 'varchar_ascii', 'length' => 24, 'not null' => FALSE],
      'cost_unpriced_reason' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
      'cost_currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => FALSE],
      'cost_total_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'started_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'first_token_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'finished_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'bucket_start' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'UTC hour of started_at in milliseconds; the rollup bucket of this attempt.'],
      'occurred_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'occurred_at of the applied event.'],
      'last_event_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE,
        'description' => 'ai_usage_event.id of the applied event.'],
      'projection_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'attempt' => ['site_id', 'attempt_id'],
      'logical_call' => ['site_id', 'operation_id', 'logical_call_id', 'attempt_no'],
    ],
    'indexes' => [
      'operation_stage' => ['site_id', 'operation_id', 'stage', 'attempt_no'],
      'supplier' => ['site_id', 'provider_account_ref', 'started_at'],
      'gateway_request' => ['site_id', 'gateway_request_id'],
      'rollup_cell' => ['site_id', 'bucket_start', 'feature', 'stage', 'payer', 'provider_account_ref',
        'model_id', 'billing_role'],
    ],
  ];

  $schema['ai_usage_rollup_hour'] = [
    'description' => 'Hourly attempt rollup recomputed per cell from ai_provider_attempt. Rebuildable; never authorizes balances.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'bucket_start' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'UTC hour start in milliseconds since epoch.'],
      'feature' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'stage' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'payer' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
      'billing_role' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => '-',
        'description' => 'primary, auxiliary, repair; sentinel "-" for attempts without a role.'],
      'provider_account_ref' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'model_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'actor_user_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE,
        'description' => 'Sentinel "-" when the attempt had no actor.'],
      'currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => TRUE,
        'description' => 'Cost entry currency; sentinel "-" when the attempt has no cost entry.'],
      'attempt_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'open_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'succeeded_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'failed_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'unknown_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'not_sent_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'usage_reported_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'usage_missing_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0,
        'description' => 'Finished attempts whose usage is missing or invalid; never counted as zero tokens.'],
      'input_tokens_total' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'input_tokens_cache_read' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'input_tokens_cache_write' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'output_tokens_total' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'output_tokens_reasoning' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'images_generated' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0,
        'description' => 'Sum of upstream-returned images of the image attempts in this cell (UB2.4).'],
      'cost_rated_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'cost_unpriced_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'projection_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'data_as_of' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Latest occurred_at applied to any attempt in this cell.'],
      'updated_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'cell' => ['site_id', 'bucket_start', 'feature', 'stage', 'payer', 'billing_role',
        'provider_account_ref', 'model_id', 'actor_user_id', 'currency'],
    ],
    'indexes' => [
      'bucket' => ['site_id', 'bucket_start'],
    ],
  ];

  $schema['ai_usage_watermark'] = [
    'description' => 'Per-site consumer watermark, advanced in the same transaction as each acknowledged event.',
    'fields' => [
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'projection' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'projection_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'last_event_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE,
        'description' => 'Highest ai_usage_event.id acknowledged so far.'],
      'processed_count' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'data_as_of' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['site_id', 'projection'],
  ];

  $schema['ai_usage_delivery'] = [
    'description' => 'Append-only delivery facts: one row per persisted or committed artifact of an attempt (UB2.4).',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'operation_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'output_index' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE,
        'description' => 'Stable index of the artifact in the provider response of the attempt.'],
      'artifact_kind' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE,
        'description' => 'media (file persisted) or image_asset (committed, readable by the user).'],
      'artifact_ref' => ['type' => 'varchar_ascii', 'length' => 191, 'not null' => TRUE,
        'description' => 'Entity UUID of the artifact.'],
      'artifact_version' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE,
        'description' => 'persisted or committed.'],
      'delivered_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'artifact' => ['site_id', 'attempt_id', 'output_index', 'artifact_kind'],
    ],
    'indexes' => [
      'operation' => ['site_id', 'operation_id'],
    ],
  ];

  return $schema;
}

/**
 * Add image_cost_micros to cost entries for the image price book (UB2 image pricing).
 */
function xinshi_ai_usage_update_10006(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Add the delivery fact table and images_generated to the projection and rollup (UB2.4), then rebuild rollups.
 */
function xinshi_ai_usage_update_10005(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Add the attempt projection, hourly rollup and watermark tables for the usage consumer (UB1.6).
 */
function xinshi_ai_usage_update_10002(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Add consumer failure bookkeeping (failure_count, last_error, quarantined_at) to ai_usage_event.
 */
function xinshi_ai_usage_update_10003(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Add billing_role to the attempt projection and the hourly rollup (UB2.1), then rebuild rollups.
 */
function xinshi_ai_usage_update_10004(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Add the price book and cost entry tables to sites that already installed the module.
 *
 * The module was deployed with only ai_usage_event before UB1.5. Updating
 * hook_schema() does not create tables on an installed Drupal module, so this
 * update is intentionally idempotent and checks existing event facts before
 * adding the new attempt-level uniqueness constraint.
 */
function xinshi_ai_usage_update_10001(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Brings an existing installation up to the current hook_schema() definition.
 *
 * Kept separate from the update hook so the upgrade path can be exercised
 * against a real database in unit tests without a bootstrapped container.
 * Safe to run more than once.
 *
 * @throws \Drupal\Core\Update\UpdateException
 *   When existing facts would violate the attempt-level unique key.
 */
function xinshi_ai_usage_apply_schema_updates(Connection $database): void {
  $schema = $database->schema();
  $definitions = xinshi_ai_usage_schema();

  $costEntryExisted = $schema->tableExists('ai_usage_cost_entry');
  foreach (['ai_price_book_version', 'ai_usage_cost_entry', 'ai_provider_attempt',
    'ai_usage_rollup_hour', 'ai_usage_watermark', 'ai_usage_delivery'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definitions[$table]);
    }
  }

  // Early UB1.5 deployments sized source_kind for 'price_book' only.
  if ($costEntryExisted && $schema->fieldExists('ai_usage_cost_entry', 'source_kind')) {
    $schema->changeField(
      'ai_usage_cost_entry',
      'source_kind',
      'source_kind',
      $definitions['ai_usage_cost_entry']['fields']['source_kind'],
    );
  }
  // Image price book: the per-image component gets its own column. Existing
  // entries are immutable and stay NULL; image attempts rated before the
  // column existed were unpriced anyway.
  if (!$schema->fieldExists('ai_usage_cost_entry', 'image_cost_micros')) {
    $schema->addField('ai_usage_cost_entry', 'image_cost_micros',
      $definitions['ai_usage_cost_entry']['fields']['image_cost_micros']);
  }

  if (!$schema->tableExists('ai_usage_event')) {
    return;
  }

  // UB1.6 consumer bookkeeping columns on the event table. The pending index
  // gains quarantined_at at the same time, so it is rebuilt only then.
  $eventFields = $definitions['ai_usage_event']['fields'];
  $addedBookkeeping = FALSE;
  foreach (['failure_count', 'last_error', 'quarantined_at'] as $field) {
    if (!$schema->fieldExists('ai_usage_event', $field)) {
      $schema->addField('ai_usage_event', $field, $eventFields[$field]);
      $addedBookkeeping = TRUE;
    }
  }
  if ($addedBookkeeping && $schema->indexExists('ai_usage_event', 'pending')) {
    $schema->dropIndex('ai_usage_event', 'pending');
  }
  if (!$schema->indexExists('ai_usage_event', 'pending')) {
    $schema->addIndex('ai_usage_event', 'pending',
      $definitions['ai_usage_event']['indexes']['pending'], $definitions['ai_usage_event']);
  }

  // UB2.1: billing_role becomes a projection column and a rollup dimension. The
  // rollup is a rebuildable cache, so its rows are dropped and the unique key is
  // recreated with the new column; the next consumer run recomputes them.
  if (!$schema->fieldExists('ai_provider_attempt', 'billing_role')) {
    $schema->addField('ai_provider_attempt', 'billing_role',
      $definitions['ai_provider_attempt']['fields']['billing_role']);
    if ($schema->indexExists('ai_provider_attempt', 'rollup_cell')) {
      $schema->dropIndex('ai_provider_attempt', 'rollup_cell');
    }
    $schema->addIndex('ai_provider_attempt', 'rollup_cell',
      $definitions['ai_provider_attempt']['indexes']['rollup_cell'], $definitions['ai_provider_attempt']);
  }
  if (!$schema->fieldExists('ai_usage_rollup_hour', 'billing_role')) {
    $database->delete('ai_usage_rollup_hour')->execute();
    $database->delete('ai_usage_watermark')->execute();
    $database->update('ai_usage_event')->fields(['processed_at' => NULL])->execute();
    if ($schema->indexExists('ai_usage_rollup_hour', 'cell')) {
      $schema->dropUniqueKey('ai_usage_rollup_hour', 'cell');
    }
    $schema->addField('ai_usage_rollup_hour', 'billing_role',
      $definitions['ai_usage_rollup_hour']['fields']['billing_role']);
    $schema->addUniqueKey('ai_usage_rollup_hour', 'cell',
      $definitions['ai_usage_rollup_hour']['unique keys']['cell']);
  }

  // UB2.4: images_generated is projected per attempt and summed per rollup cell.
  // Existing cells would keep 0 forever without a recompute, so the rollup is
  // reset the same way as for billing_role.
  if (!$schema->fieldExists('ai_provider_attempt', 'images_generated')) {
    $schema->addField('ai_provider_attempt', 'images_generated',
      $definitions['ai_provider_attempt']['fields']['images_generated']);
  }
  if (!$schema->fieldExists('ai_usage_rollup_hour', 'images_generated')) {
    $database->delete('ai_usage_rollup_hour')->execute();
    $database->delete('ai_usage_watermark')->execute();
    $database->update('ai_usage_event')->fields(['processed_at' => NULL])->execute();
    $schema->addField('ai_usage_rollup_hour', 'images_generated',
      $definitions['ai_usage_rollup_hour']['fields']['images_generated']);
  }

  if ($schema->indexExists('ai_usage_event', 'attempt_revision')) {
    return;
  }

  // addExpression() returns the alias, not the query, so the query is built
  // step by step instead of in one chain.
  $query = $database->select('ai_usage_event', 'e')
    ->fields('e', ['site_id', 'attempt_id', 'event_type', 'observation_revision']);
  $query->addExpression('COUNT(*)', 'row_count');
  $duplicate = $query
    ->groupBy('site_id')
    ->groupBy('attempt_id')
    ->groupBy('event_type')
    ->groupBy('observation_revision')
    ->having('COUNT(*) > 1')
    ->range(0, 1)
    ->execute()
    ->fetchAssoc();
  if ($duplicate) {
    throw new UpdateException(sprintf(
      'Cannot add the attempt_revision unique key: duplicate facts exist for %s / %s / %s / %s.',
      $duplicate['site_id'],
      $duplicate['attempt_id'],
      $duplicate['event_type'],
      $duplicate['observation_revision'],
    ));
  }

  $schema->addUniqueKey('ai_usage_event', 'attempt_revision', [
    'site_id',
    'attempt_id',
    'event_type',
    'observation_revision',
  ]);
}
