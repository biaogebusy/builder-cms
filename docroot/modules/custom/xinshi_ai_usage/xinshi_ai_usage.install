<?php

/**
 * @file
 * Schema for immutable AI usage facts and purchasing cost rating (UB1.1 / UB1.4 / UB1.5).
 *
 * The tables live in their own module so uninstalling the task runner
 * (xinshi_ai) never drops financial facts.
 */

declare(strict_types=1);

use Drupal\Core\Database\Connection;
use Drupal\Core\Utility\UpdateException;

/**
 * Implements hook_schema().
 */
function xinshi_ai_usage_schema(): array {
  $schema['ai_usage_event'] = [
    'description' => 'Append-only usage events received from registered producers.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'producer_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'event_id' => ['type' => 'varchar_ascii', 'length' => 191, 'not null' => TRUE],
      'event_type' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'schema_version' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'operation_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'observation_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'payload_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // Milliseconds since the Unix epoch, UTC; the same precision the Node producer uses.
      'occurred_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'received_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      // NULL until the aggregation consumer (UB1.6) has applied the event.
      'processed_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'payload_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'dedup' => ['site_id', 'producer_id', 'event_id'],
      'attempt_revision' => ['site_id', 'attempt_id', 'event_type', 'observation_revision'],
    ],
    'indexes' => [
      'attempt' => ['site_id', 'attempt_id', 'event_type', 'observation_revision'],
      'operation' => ['site_id', 'operation_id'],
      'pending' => ['processed_at', 'id'],
    ],
  ];

  $schema['ai_price_book_version'] = [
    'description' => 'Versioned purchasing price books. Active version supplies rates for cost rating.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'book_kind' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE,
        'description' => 'E.g. supplier_chat; different kinds have different rate structures.'],
      'version' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE,
        'description' => 'Human-readable version label, unique per site + kind.'],
      'currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => TRUE,
        'description' => 'ISO 4217 code, e.g. CNY, USD.'],
      'rates_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Structured rates keyed by provider account ref and model id.'],
      'rounding_policy' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => 'half_up',
        'description' => 'Rounding applied when converting token * per-million rate to micros.'],
      'status' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => 'draft',
        'description' => 'draft or active; only one active version per site + kind at a time.'],
      'source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE,
        'description' => 'Optional reference to supplier quote, invoice or contract.'],
      'effective_from' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Milliseconds since epoch; cost rating matches by attempt occurred_at.'],
      'effective_to' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'NULL means open-ended; new version replaces active atomically.'],
      'created_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'created_by' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'version' => ['site_id', 'book_kind', 'version'],
    ],
    'indexes' => [
      'active' => ['site_id', 'book_kind', 'status', 'effective_from'],
    ],
  ];

  $schema['ai_usage_cost_entry'] = [
    'description' => 'Supplier cost computed for one observed attempt revision. Append-only.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'site_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'observation_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'price_version_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE,
        'description' => 'NULL when valuation_state is unpriced.'],
      'currency' => ['type' => 'varchar_ascii', 'length' => 8, 'not null' => FALSE],
      'input_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'cache_read_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'cache_write_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'output_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'total_cost_micros' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'valuation_state' => ['type' => 'varchar_ascii', 'length' => 24, 'not null' => TRUE,
        'description' => 'unpriced, rated_estimate, reconciled. Unpriced means no matching rate was found.'],
      'unpriced_reason' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE,
        'description' => 'Short code explaining why cost is unpriced, e.g. unknown_model.'],
      'source_kind' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE, 'default' => 'price_book',
        'description' => 'price_book or supplier_reconciliation.'],
      'computed_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'attempt_revision' => ['site_id', 'attempt_id', 'observation_revision', 'source_kind'],
    ],
    'indexes' => [
      'operation_lookup' => ['site_id', 'attempt_id'],
      'valuation' => ['site_id', 'valuation_state'],
    ],
  ];

  return $schema;
}

/**
 * Add the price book and cost entry tables to sites that already installed the module.
 *
 * The module was deployed with only ai_usage_event before UB1.5. Updating
 * hook_schema() does not create tables on an installed Drupal module, so this
 * update is intentionally idempotent and checks existing event facts before
 * adding the new attempt-level uniqueness constraint.
 */
function xinshi_ai_usage_update_10001(): void {
  xinshi_ai_usage_apply_schema_updates(\Drupal::database());
}

/**
 * Brings an existing installation up to the current hook_schema() definition.
 *
 * Kept separate from the update hook so the upgrade path can be exercised
 * against a real database in unit tests without a bootstrapped container.
 * Safe to run more than once.
 *
 * @throws \Drupal\Core\Update\UpdateException
 *   When existing facts would violate the attempt-level unique key.
 */
function xinshi_ai_usage_apply_schema_updates(Connection $database): void {
  $schema = $database->schema();
  $definitions = xinshi_ai_usage_schema();

  $costEntryExisted = $schema->tableExists('ai_usage_cost_entry');
  foreach (['ai_price_book_version', 'ai_usage_cost_entry'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definitions[$table]);
    }
  }

  // Early UB1.5 deployments sized source_kind for 'price_book' only.
  if ($costEntryExisted && $schema->fieldExists('ai_usage_cost_entry', 'source_kind')) {
    $schema->changeField(
      'ai_usage_cost_entry',
      'source_kind',
      'source_kind',
      $definitions['ai_usage_cost_entry']['fields']['source_kind'],
    );
  }

  if (!$schema->tableExists('ai_usage_event')
    || $schema->indexExists('ai_usage_event', 'attempt_revision')) {
    return;
  }

  $duplicate = $database->select('ai_usage_event', 'e')
    ->fields('e', ['site_id', 'attempt_id', 'event_type', 'observation_revision'])
    ->addExpression('COUNT(*)', 'row_count')
    ->groupBy('site_id')
    ->groupBy('attempt_id')
    ->groupBy('event_type')
    ->groupBy('observation_revision')
    ->having('COUNT(*) > 1')
    ->range(0, 1)
    ->execute()
    ->fetchAssoc();
  if ($duplicate) {
    throw new UpdateException(sprintf(
      'Cannot add the attempt_revision unique key: duplicate facts exist for %s / %s / %s / %s.',
      $duplicate['site_id'],
      $duplicate['attempt_id'],
      $duplicate['event_type'],
      $duplicate['observation_revision'],
    ));
  }

  $schema->addUniqueKey('ai_usage_event', 'attempt_revision', [
    'site_id',
    'attempt_id',
    'event_type',
    'observation_revision',
  ]);
}
