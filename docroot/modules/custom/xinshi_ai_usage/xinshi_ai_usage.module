<?php

/**
 * @file
 * Cron fallback for the usage projection consumer.
 */

declare(strict_types=1);

/** Implements hook_xinshi_api_data_alter(). */
function xinshi_ai_usage_xinshi_api_data_alter(&$data, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Cache\CacheableMetadata $metadata): void {
  if (!is_array($data) || (\Drupal::request()->query->all()['content'] ?? NULL) !== '/core/base') return;
  $data['finance'] = \Drupal::getContainer()->getParameter('xinshi_site_finance');
  $metadata->addCacheTags(['config:core.extension', 'config:xinshi_credits.settings', 'config:xinshi_ai_billing.settings']);
}

/**
 * Implements hook_cron().
 *
 * Keeps the projection moving on deployments without a scheduled Drush run.
 * The service takes its own lock, so an overlapping manual command is safe.
 */
function xinshi_ai_usage_cron(): void {
  \Drupal::service('xinshi_ai_usage.currency_display')->refresh();
  try {
    $stats = \Drupal::service('xinshi_ai_usage.projection')->process(NULL, 500);
    if ($stats['failed'] > 0 || $stats['quarantined'] > 0) {
      \Drupal::logger('xinshi_ai_usage')->error('Usage projection cron: @failed event(s) failed, @quarantined quarantined; run drush xinshi-ai-usage:release-quarantined after fixing the cause.', [
        '@failed' => $stats['failed'], '@quarantined' => $stats['quarantined'],
      ]);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('xinshi_ai_usage')->error('Usage projection cron failed: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
  // Export files are short-lived downloads (UB3.4); drop them with their rows.
  try {
    $nowMs = (int) round(\Drupal::time()->getCurrentMicroTime() * 1000);
    \Drupal::service('xinshi_ai_usage.export')->purgeExpired($nowMs);
  }
  catch (\Throwable $e) {
    \Drupal::logger('xinshi_ai_usage')->error('Usage export purge failed: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}
