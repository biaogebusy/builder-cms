<?php

declare(strict_types=1);

/** Implements hook_cron(). */
function xinshi_ai_billing_cron(): void {
  if (\Drupal::hasService('xinshi_ai_billing.images')) \Drupal::service('xinshi_ai_billing.images')->reconcile();
}

/** Implements hook_entity_predelete(). */
function xinshi_ai_billing_entity_predelete(\Drupal\Core\Entity\EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'image_job') {
    if (\Drupal::hasService('xinshi_ai_billing.images')) {
      \Drupal::service('xinshi_ai_billing.images')->assertDeletable($entity->uuid());
    }
  }
}
