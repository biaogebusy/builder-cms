<?php

/**
 * @file
 * Xinshi AI module hooks.
 *
 * AI 任务统一后端。内容类型、路由、SSE 等业务实现见 src/。
 * 本文件仅放必要的过程式 hook,尽量保持精简。
 */

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * Implements hook_cron().
 *
 * Image jobs whose worker died keep a running lease row past its expiry. A
 * queue item redelivered while that lease still looks live is dropped, so the
 * queue alone would leave such a job running forever. Cron closes them from
 * the recorded evidence, never by calling the model again (UB2.5).
 */
function xinshi_ai_cron(): void {
  \Drupal::service('xinshi_ai.image_job_executor')->recoverExpired();
}

/**
 * Implements hook_ENTITY_TYPE_delete() for node entities.
 *
 * Deleting an image job removes the customer key stored for it (UB2.7). The
 * usage facts of the job live in xinshi_ai_usage, keyed by UUID without a
 * foreign key, and are deliberately left alone: deleting content never
 * deletes what was consumed or billed.
 */
function xinshi_ai_node_delete(NodeInterface $node): void {
  if ($node->bundle() === 'image_job') {
    \Drupal::service('xinshi_ai.image_job_credentials')->delete($node->uuid());
  }
}
