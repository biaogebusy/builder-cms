<?php

/**
 * @file
 * Install / update hooks and schema for Xinshi AI.
 */

declare(strict_types=1);

use Drupal\Core\Database\Connection;

/**
 * Implements hook_schema().
 */
function xinshi_ai_schema(): array {
  $schema['xinshi_ai_image_job_run'] = [
    'description' => 'Execution lease of one image job: at most one worker runs a job at a time (UB2.5).',
    'fields' => [
      'job_uuid' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'run_token' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE,
        'description' => 'Identifies the worker run holding the lease; renewals and releases must present it.'],
      'queue_attempt' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0,
        'description' => 'Retry counter of the queue item that started this run.'],
      'worker' => ['type' => 'varchar', 'length' => 191, 'not null' => FALSE,
        'description' => 'host:pid of the holder, for diagnostics only.'],
      'usage_attempt_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE,
        'description' => 'The metering attempt opened by this run, when usage recording is available.'],
      'state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE,
        'description' => 'running or finished.'],
      'claimed_at' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'lease_until' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE,
        'description' => 'Milliseconds; a running row past this instant belongs to a dead worker.'],
      'dispatched_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'The image request left the process; NULL means the provider was never called.'],
      'responded_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE,
        'description' => 'The provider answered; the supplier cost exists from here on.'],
      'finished_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
    ],
    'primary key' => ['job_uuid'],
    'indexes' => [
      'expired' => ['state', 'lease_until'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function xinshi_ai_install(): void {
  // config/install/ 内的 yml 由 Drupal 在安装时自动导入。
  // 给已认证用户授予图片任务的创建 / 取消权限。
  if (\Drupal::moduleHandler()->moduleExists('user')) {
    user_role_grant_permissions('authenticated', [
      'create xinshi_ai image job',
      'cancel xinshi_ai image job',
    ]);
  }
}

/**
 * 重新导入 image_jobs view,添加后台管理列表页(page_admin display)。
 */
function xinshi_ai_update_10001(): void {
  $config_path = \Drupal::service('extension.list.module')->getPath('xinshi_ai') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');

  $config_name = 'views.view.image_jobs';
  $data = $source->read($config_name);
  if ($data) {
    $config_storage->write($config_name, $data);
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['config:' . $config_name]);
  }
}

/**
 * 为模型注册中心补种各模式默认模型(defaults 键;已设置的站点不覆盖)。
 */
function xinshi_ai_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('xinshi_ai.models');
  if ($config->get('defaults') !== NULL) {
    return;
  }
  $existing = array_column($config->get('models') ?? [], NULL, 'id');
  $seed = [
    'chat' => 'deepseek-v4-pro',
    'image' => 'qwen-image-plus',
    'image-edit' => 'qwen-image-edit-plus',
  ];
  // 只写入当前注册中心里真实存在的模型,避免站点自定义清单后指向悬空 id。
  $defaults = array_filter($seed, static fn(string $id): bool => isset($existing[$id]));
  if ($defaults !== []) {
    $config->set('defaults', $defaults)->save();
  }
}

/**
 * Add the image job execution lease table (UB2.5).
 */
function xinshi_ai_update_10003(): void {
  xinshi_ai_apply_schema_updates(\Drupal::database());
}

/**
 * Remove custom-platform endpoints and API keys stored in image_job params (UB2.7).
 */
function xinshi_ai_update_10004(array &$sandbox): string {
  $database = \Drupal::database();
  if (!isset($sandbox['tables'])) {
    $sandbox['tables'] = array_values(array_filter(['node__field_params', 'node_revision__field_params'],
      fn(string $table): bool => $database->schema()->tableExists($table)));
    $sandbox['last_revision'] = 0;
    $sandbox['updated'] = 0;
  }
  while ($sandbox['tables'] !== []) {
    $result = xinshi_ai_scrub_credentials_batch($database, $sandbox['tables'][0], (int) $sandbox['last_revision'], 200);
    $sandbox['updated'] += $result['updated'];
    $sandbox['last_revision'] = $result['last_revision'];
    if (!$result['done']) {
      $sandbox['#finished'] = 0.5;
      return sprintf('Scrubbing %s; %d rows cleaned so far.', $sandbox['tables'][0], $sandbox['updated']);
    }
    array_shift($sandbox['tables']);
    $sandbox['last_revision'] = 0;
  }
  $sandbox['#finished'] = 1;
  return sprintf('Removed stored credentials from %d image_job params rows.', $sandbox['updated']);
}

/**
 * Strips connection secrets from one batch of image_job params rows.
 *
 * Works on the field data and field revision tables alike, walking them by
 * revision_id so a run interrupted half-way resumes where it stopped. Kept
 * separate from the update hook so it can be exercised against a real
 * database in unit tests.
 *
 * @return array{last_revision: int, updated: int, done: bool}
 */
function xinshi_ai_scrub_credentials_batch(Connection $database, string $table, int $lastRevision, int $limit): array {
  $secretKeys = ['endpoint', 'api_key', 'apiKey', 'baseURL'];
  $revisions = $database->select($table, 'p')
    ->fields('p', ['revision_id'])
    ->condition('p.bundle', 'image_job')
    ->condition('p.revision_id', $lastRevision, '>')
    ->orderBy('p.revision_id')
    ->distinct()
    ->range(0, max(1, $limit))
    ->execute()
    ->fetchCol();
  if ($revisions === []) {
    return ['last_revision' => $lastRevision, 'updated' => 0, 'done' => TRUE];
  }
  $updated = 0;
  $rows = $database->select($table, 'p')
    ->fields('p', ['entity_id', 'revision_id', 'deleted', 'delta', 'langcode', 'field_params_value'])
    ->condition('p.bundle', 'image_job')
    ->condition('p.revision_id', array_map('intval', $revisions), 'IN')
    ->execute()
    ->fetchAll(\PDO::FETCH_ASSOC);
  foreach ($rows as $row) {
    $params = json_decode((string) $row['field_params_value'], TRUE);
    if (!is_array($params) || array_intersect_key($params, array_flip($secretKeys)) === []) {
      continue;
    }
    foreach ($secretKeys as $key) {
      unset($params[$key]);
    }
    $database->update($table)
      ->fields(['field_params_value' => json_encode($params, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)])
      ->condition('entity_id', (int) $row['entity_id'])
      ->condition('revision_id', (int) $row['revision_id'])
      ->condition('deleted', (int) $row['deleted'])
      ->condition('delta', (int) $row['delta'])
      ->condition('langcode', (string) $row['langcode'])
      ->execute();
    $updated++;
  }
  return ['last_revision' => (int) max($revisions), 'updated' => $updated, 'done' => count($revisions) < max(1, $limit)];
}

/**
 * Brings an installed site up to the current hook_schema(); safe to run repeatedly.
 *
 * Kept separate from the update hook so the upgrade path can be exercised
 * against a real database in unit tests without a bootstrapped container.
 */
function xinshi_ai_apply_schema_updates(Connection $database): void {
  $schema = $database->schema();
  foreach (xinshi_ai_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }
}
