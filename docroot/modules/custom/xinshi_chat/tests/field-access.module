<?php

/**
 * @file
 * Adds a per-record field denial only on the disposable Chat test site.
 */

/** Implements hook_entity_field_access(). */
function xinshi_chat_test_entity_field_access($operation, $definition, $account, $items = NULL) {
  return \Drupal\Core\Access\AccessResult::forbiddenIf($operation === 'view' && $items &&
    (($definition->getName() === 'title' &&
      (string) $items->getEntity()->id() === (string) \Drupal::state()->get('xinshi_chat_test.hidden_title', '')) ||
    ($definition->getName() === 'sessions' &&
      (string) $items->getEntity()->id() === (string) \Drupal::state()->get('xinshi_chat_test.hidden_sessions', ''))))
    ->setCacheMaxAge(0);
}

/** Implements hook_node_access(). */
function xinshi_chat_test_node_access($node, $operation, $account) {
  return \Drupal\Core\Access\AccessResult::forbiddenIf($operation === 'delete' &&
    (string) $node->id() === (string) \Drupal::state()->get('xinshi_chat_test.denied_delete', ''))
    ->setCacheMaxAge(0);
}

/** Implements hook_node_delete(). */
function xinshi_chat_test_node_delete($node): void {
  if ((string) $node->id() === (string) \Drupal::state()->get('xinshi_chat_test.fail_delete', '')) {
    throw new \RuntimeException('Synthetic deletion failure');
  }
}
