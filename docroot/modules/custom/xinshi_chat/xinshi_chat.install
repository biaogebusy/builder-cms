<?php

/**
 * @file
 * Installs Chat configuration and explicit public snapshots without converting messages.
 */

/** Implements hook_schema(). */
function xinshi_chat_schema(): array {
  return ['xinshi_chat_published_page' => [
    'description' => 'Explicit public HTML snapshots, independent of private message storage.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'session_uuid' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'conversation_uuid' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'html' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'html_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'edit_version' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      'updated' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['session_uuid'],
    'unique keys' => ['public_id' => ['id']],
    'indexes' => ['conversation' => ['conversation_uuid'], 'author' => ['uid']],
  ]];
}

/** Create an empty publication store; existing messages and old links stay private. */
function xinshi_chat_update_11003(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('xinshi_chat_published_page')) {
    $schema->createTable('xinshi_chat_published_page', xinshi_chat_schema()['xinshi_chat_published_page']);
  }
  return 'Explicit Chat page publication storage is installed.';
}

/** Implements hook_install(). */
function xinshi_chat_install($is_syncing): void {
  $manager = \Drupal::service('xinshi_chat.schema');
  if ($is_syncing) {
    // The new module's event subscriber did not exist during IMPORT_VALIDATE.
    $source = \Drupal::service('config.installer')->getSourceStorage();
    $errors = \Drupal\xinshi_chat\EventSubscriber\ConfigImportSubscriber::errors($source);
    if ($manager->hasContent() && \Drupal::config('xinshi_ai_reference.settings')->get('storage_version') !== 3) {
      $errors[] = 'Migrate existing Chat data before installing Chat through configuration import.';
    }
    if ($errors) {
      throw new \RuntimeException(implode(' ', $errors));
    }
    return;
  }
  $manager->apply();
}

/** Adopt the version 1 structure without resetting site configuration or data. */
function xinshi_chat_update_11001(): string {
  if ((\Drupal::config('xinshi_chat.settings')->get('schema_version') ?? 0) <= 1) {
    \Drupal::service('xinshi_chat.schema')->apply(1);
  }
  return 'Chat structure version 1 is installed and verified.';
}

/** Add the default-on conversation web search preference without changing message storage. */
function xinshi_chat_update_11002(): string {
  \Drupal::service('xinshi_chat.schema')->apply(2);
  return 'Conversation web search preference is installed.';
}

/** Implements hook_requirements(). */
function xinshi_chat_requirements($phase): array {
  if ($phase !== 'runtime' || !\Drupal::hasService('xinshi_chat.schema')) {
    return [];
  }
  $report = \Drupal::service('xinshi_chat.schema')->inspect();
  $valid = $report['matches'] && $report['installed_version'] === $report['target_version'];
  return ['xinshi_chat_structure' => [
    'title' => t('Chat structure'),
    'value' => $valid ? t('Current') : t('Update or repair required'),
    'description' => t('Run drush xinshi-chat:check for the configuration differences.'),
    'severity' => $valid ? REQUIREMENT_OK : REQUIREMENT_ERROR,
  ]];
}
