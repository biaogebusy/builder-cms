<?php

/**
 * @file
 * Schema and updates for the Xinshi API module.
 */

/**
 * Implements hook_schema().
 */
function xinshi_api_schema() {
  $schema['xinshi_page_draft_operation'] = [
    'description' => 'Immutable owner-bound results of page draft creation operations.',
    'fields' => [
      'execution_id' => ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'input_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'result_json' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['execution_id'],
    'indexes' => ['owner' => ['uid']],
  ];
  return $schema;
}

/**
 * Add the transactional idempotency ledger for page drafts.
 */
function xinshi_api_update_10001() {
  $schema = \Drupal::database()->schema();
  $table = 'xinshi_page_draft_operation';
  if (!$schema->tableExists($table)) {
    $schema->createTable($table, xinshi_api_schema()[$table]);
  }
}

/**
 * Serve the api/v3 endpoints from controller routes instead of REST resources.
 *
 * The REST resources required the generated "restful get ..." permission, which
 * no role held, so every endpoint answered 403 for non-admin users.
 */
function xinshi_api_update_10002() {
  $ids = [
    'xinshi_api_account_rest',
    'xinshi_api_comment_rest',
    'xinshi_api_landing_page_rest',
    'xinshi_api_node_component_rest',
    'xinshi_api_statistics_node_rest',
    'xinshi_api_statistics_register_rest',
    'xinshi_api_webform_rest',
  ];
  // The plugin classes ship deleted with this release, so the config entity
  // API cannot remove these: its preDelete dependency handling saves dependent
  // roles, which resolves every still-existing resource's plugin and fatal
  // errors. Removing the raw config skips that dependency handling.
  $config_factory = \Drupal::configFactory();
  foreach ($ids as $id) {
    $config_factory->getEditable("rest.resource.$id")->delete();
  }
  \Drupal\Core\Cache\Cache::invalidateTags(['config:rest_resource_config_list']);
  // The permission is gone with the resource; drop the grants it left behind.
  $permissions = array_map(static fn(string $id): string => "restful get $id", $ids);
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
  foreach ($role_storage->loadMultiple() as $role) {
    $stale = array_intersect($permissions, $role->getPermissions());
    if (!$stale) {
      continue;
    }
    foreach ($stale as $permission) {
      $role->revokePermission($permission);
    }
    $role->save();
  }
}

/**
 * Add missing API settings without replacing existing site choices.
 */
function xinshi_api_update_10003() {
  // Keep these defaults fixed: future install defaults must not change upgrades.
  $defaults = [
    'page' => ['not_found' => '', 'access_denied' => ''],
    'cache_enable' => FALSE,
    'node_cache' => [],
    'taxonomy_term_cache' => [],
    'user_cache' => [],
    'debug' => FALSE,
  ];
  $config = \Drupal::configFactory()->getEditable('xinshi_api.settings');
  $data = $config->getRawData() + $defaults;
  if (is_array($data['page'])) {
    $data['page'] += $defaults['page'];
  }
  // Normal saves apply the schema's boolean/string casts to legacy checkboxes.
  $config->setData($data)->save();
}

/**
 * Purge permission cache entries written before OAuth account isolation.
 *
 * The old access-policy cache varied by the scope-filtered user.roles context,
 * so accounts sharing the same token scopes shared one entry: an ordinary
 * user's entry then answered an administrator's requests with 403 after the
 * account-isolating context was added. New entries vary by that context, but
 * the VariationCache still serves legacy entries varying by fewer contexts, so
 * they survive until the bin is cleared. updatedb must therefore purge them,
 * because a deploy that skips cache:rebuild keeps serving the stale entry.
 */
function xinshi_api_update_10004() {
  // The bin is a core service since the access-policy system; older cores
  // listed in core_version_requirement never wrote these entries.
  if (\Drupal::hasService('cache.access_policy')) {
    \Drupal::cache('access_policy')->deleteAll();
  }
}

/**
 * Allow direct republication in the Builder baseline's editorial workflow.
 */
function xinshi_api_update_10005() {
  if (!\Drupal::moduleHandler()->moduleExists('content_moderation')) {
    return;
  }
  $config = \Drupal::configFactory()->getEditable('workflows.workflow.editorial');
  $settings = $config->get('type_settings');
  // Limit the upgrade to the baseline workflow; custom workflow policies stay site-owned.
  if ($config->isNew() || $config->get('type') !== 'content_moderation' ||
      !in_array('landing_page', $settings['entity_types']['node'] ?? [], TRUE) ||
      !isset($settings['states']['unpublished'], $settings['states']['published']) ||
      ($settings['states']['unpublished']['published'] ?? TRUE) !== FALSE ||
      ($settings['states']['published']['published'] ?? FALSE) !== TRUE ||
      ($settings['transitions']['publish']['to'] ?? '') !== 'published') {
    return;
  }
  $from = $settings['transitions']['publish']['from'] ?? [];
  if (!in_array('unpublished', $from, TRUE)) {
    $from[] = 'unpublished';
    // Reuse the existing publish transition and its permissions; do not grant roles new access.
    $config->set('type_settings.transitions.publish.from', $from)->save();
  }
}
