<?php

/**
 * @file
 * Media widget editing support retained from the previous site.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\CloseModalDialogCommand;
use Drupal\Core\Ajax\ReplaceCommand;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Messenger\MessengerInterface;
use Drupal\Core\Render\Element;

/** Implements hook_form_FORM_ID_alter(). */
function xinshi_legacy_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::request()->query->get('media_library_edit') !== 'ajax'
    || $form_state->getFormObject()->getOperation() !== 'edit') {
    return;
  }
  $form['revision_information']['#access'] = FALSE;
  foreach (Element::children($form['actions']) as $key) {
    if ($key === 'submit') {
      $form['actions'][$key]['#name'] = 'media_library_ajax_submit';
      $form['actions'][$key]['#ajax'] = ['callback' => 'xinshi_legacy_media_form_ajax_submit'];
      $form['actions'][$key]['#attributes']['data-disable-refocus'] = 'true';
      $form['#attached']['library'][] = 'core/drupal.dialog.ajax';
      $form['#id'] = Html::getId($form_state->getBuildInfo()['form_id']);
    }
    else {
      $form['actions'][$key]['#access'] = FALSE;
    }
  }
}

/** Refreshes the existing widget after the normal media form saves successfully. */
function xinshi_legacy_media_form_ajax_submit(array &$form, FormStateInterface $form_state): AjaxResponse {
  $response = new AjaxResponse();
  if ($form_state->hasAnyErrors()) {
    $form['status_messages'] = ['#type' => 'status_messages', '#weight' => -1000];
    $response->addCommand(new ReplaceCommand('#' . Html::getId($form['#id']), $form));
    return $response;
  }
  $media = $form_state->getFormObject()->getEntity();
  $render = \Drupal::entityTypeManager()->getViewBuilder('media')->view($media, 'media_library');
  $html = \Drupal::service('renderer')->renderInIsolation($render);
  $response->addCommand(new CloseModalDialogCommand());
  $selector = \Drupal::request()->query->get('media_library_edit_selector');
  if (is_string($selector) && $selector !== '') {
    $response->addCommand(new ReplaceCommand('#' . Html::getId($selector) . ' .contextual-region', $html));
  }
  \Drupal::messenger()->deleteByType(MessengerInterface::TYPE_STATUS);
  return $response;
}
