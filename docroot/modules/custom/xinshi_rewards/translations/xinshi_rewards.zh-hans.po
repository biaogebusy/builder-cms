msgid ""
msgstr ""
"Language: zh-hans\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "@amount credits"
msgstr "@amount 积分"

msgid "Available credits"
msgstr "可用积分"

msgid "Confirm gift"
msgstr "确认赠送"

msgid "Confirmed value"
msgstr "已复核值"

msgid "Credit gift unavailable: @reason"
msgstr "暂时无法赠送积分：@reason"

msgid "Credits granted."
msgstr "积分已发放。"

msgid "Credits to give"
msgstr "赠送积分数量"

msgid "Edit gift"
msgstr "编辑赠送内容"

msgid "Enter a positive amount with at most 3 decimal places. No amount is selected by default."
msgstr "请输入大于零的数量，最多 3 位小数。系统不预设赠送数量。"

msgid "Expiry (UTC)"
msgstr "到期时间（UTC）"

msgid "Field"
msgstr "字段"

msgid "Gift committed"
msgstr "赠送已入账"

msgid "Gift not accepted: @reason"
msgstr "赠送未受理：@reason"

msgid "Gift status could not be confirmed. Retry this review with the same request."
msgstr "暂时无法确认赠送结果。请保留此次复核内容，并使用同一请求重试。"

msgid "Give credits to managed users"
msgstr "向受管理用户赠送积分"

msgid "Give credits within the published G12 amount, scope, expiry and budget limits."
msgstr "在已发布的 G12 数量、范围、有效期和预算内赠送积分。"

msgid "Give user credits"
msgstr "向用户赠送积分"

msgid "Grant only after the site has verified the user against its reward eligibility policy."
msgstr "站点核实用户符合奖励资格后，才允许发放。"

msgid "Internal audit note"
msgstr "内部审核备注"

msgid "Leave empty for no expiry when the published policy permits it. Otherwise use YYYY-MM-DD HH:MM:SS, no later than the published expiry."
msgstr "已发布规则允许不过期时，可留空。如需到期，请填写 YYYY-MM-DD HH:MM:SS，且不晚于已发布的最晚到期时间。"

msgid "No expiry"
msgstr "不过期"

msgid "Pool @pool. Per-gift maximum: @limit. Remaining pool: @remaining. Scope: @scope. Latest expiry (UTC): @expiry."
msgstr "奖励池：@pool。单次上限：@limit。剩余额度：@remaining。消费范围：@scope。最晚到期时间（UTC）：@expiry。"

msgid "Published authorization"
msgstr "已发布赠送规则"

msgid "Published pool"
msgstr "已发布奖励池"

msgid "Qualify for daily active-visit credits"
msgstr "领取每日活跃访问积分"

msgid "Reason shown to the recipient"
msgstr "向接收用户显示的原因"

msgid "Receive first-visit credits"
msgstr "领取首次登录积分"

msgid "Receive the published welcome reward once per site and user."
msgstr "每个用户在本站仅领取一次已发布的首次登录奖励。"

msgid "Recipient user ID"
msgstr "接收用户 ID"

msgid "Recipient: @name (user ID @id). Current account state: @state."
msgstr "接收用户：@name（用户 ID：@id）。当前积分账户状态：@state。"

msgid "Review gift"
msgstr "复核赠送内容"

msgid "Reward qualifications and accepted requests must be retained. Pause admission in configuration."
msgstr "必须保留奖励资格和已受理请求。请通过配置暂停新发放。"

msgid "Scope"
msgstr "消费范围"

msgid "Transaction: @id. The recipient can read the transaction and notification."
msgstr "流水编号：@id。接收用户可以查看此流水和通知。"

msgid "Administrator gift settings"
msgstr "管理员赠送配置"

msgid "Configure per-gift and total limits, or select unlimited."
msgstr "设置单次上限和累计总额度，也可分别选择无限制。"

msgid "Set each limit to a specific amount or unlimited. The total is shared by all administrators using this allocation. Saving a rule does not give credits to a user."
msgstr "单次上限和累计总额度可分别设置为指定数值或无限制。所有管理员共用当前规则的累计总额度。保存规则不会向用户发放积分。"

msgid "Review administrator gift settings"
msgstr "复核管理员赠送配置"

msgid "Publishing enables a new allocation with its own issued total. Previous gifts and balances remain unchanged. Use pause or resume to keep the current allocation and its issued total."
msgstr "发布后启用新规则，并重新累计新规则的已赠数量。历史赠送记录和余额保持不变。暂停或恢复会保留当前规则及其已赠数量。"

msgid "Publish and enable administrator gifts"
msgstr "发布并启用管理员赠送"

msgid "Administrator gifts"
msgstr "管理员赠送"

msgid "Not configured"
msgstr "未配置"

msgid "Enabled"
msgstr "已启用"

msgid "Paused"
msgstr "已暂停"

msgid "Site credit grants are paused. An administrator must enable site grants before users can receive gifts."
msgstr "站点积分赠送已暂停，管理员需先启用站点赠送开关才能向用户赠送积分。"

msgid "Current allocation"
msgstr "当前赠送规则"

msgid "Pause administrator gifts"
msgstr "暂停管理员赠送"

msgid "Resume administrator gifts"
msgstr "恢复管理员赠送"

msgid "New administrator gift allocation"
msgstr "发布新的管理员赠送规则"

msgid "Per-gift limit"
msgstr "单次上限"

msgid "Total allocation limit"
msgstr "累计总额度"

msgid "Specific amount"
msgstr "指定数值"

msgid "Unlimited"
msgstr "无限制"

msgid "@limit (credits)"
msgstr "@limit（积分）"

msgid "For a specific amount, enter a positive number with at most 3 decimal places."
msgstr "选择指定数值时，请填写正数，最多保留 3 位小数。"

msgid "Scope and dates"
msgstr "用途与期限"

msgid "Use comma-separated service categories from the site credit rules."
msgstr "填写站点积分规则中的服务类别，用英文逗号分隔。"

msgid "Issuance ends (UTC)"
msgstr "赠送截止时间（UTC）"

msgid "Use YYYY-MM-DD HH:MM. This stops new gifts without expiring credits already given."
msgstr "使用 YYYY-MM-DD HH:MM 格式。到达此时间后停止新的赠送，已赠积分不会因此到期。"

msgid "Leave empty for no expiry. Otherwise use YYYY-MM-DD HH:MM."
msgstr "留空表示不过期。指定时间时，使用 YYYY-MM-DD HH:MM 格式。"

msgid "Administrator gift settings saved. No credits were issued."
msgstr "管理员赠送配置已保存，本次未发放积分。"

msgid "The settings could not be saved. Retry the same reviewed configuration."
msgstr "配置未能保存，请重试当前已复核的配置。"

msgid "Credits already given"
msgstr "已赠积分"

msgid "Select unlimited or enter a positive credit amount for each limit."
msgstr "请为每项上限选择无限制，或填写正数积分。"

msgid "Check the UTC dates. Issuance must end in the future, and a specified expiry must also be in the future."
msgstr "请检查 UTC 时间，赠送截止时间和指定的积分到期时间都必须晚于当前时间。"

msgid "Administrator gift settings changed. Reload this page and review the current rule."
msgstr "管理员赠送配置已更改，请重新加载页面并复核当前规则。"

msgid "This site has budgeted credit records or rules. Configure administrator gifts through the existing budget publication process."
msgstr "本站已有预算模式的积分记录或规则，请通过原预算发布流程配置管理员赠送。"

msgid "Check the gift settings and administrator permissions. Error: @reason"
msgstr "请检查赠送配置和管理员权限，错误代码：@reason。"

msgid "No active administrator gift rule is configured. Ask a configuration administrator to publish one in Administrator gift settings."
msgstr "尚未配置有效的管理员赠送规则，请联系配置管理员在“管理员赠送配置”中发布规则。"

msgid "Administrator gifts are paused. Ask a configuration administrator to configure or resume them in Administrator gift settings."
msgstr "管理员赠送已暂停，请联系配置管理员在“管理员赠送配置”中配置或恢复赠送。"
