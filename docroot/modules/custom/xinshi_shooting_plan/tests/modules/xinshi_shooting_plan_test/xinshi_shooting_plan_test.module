<?php

/**
 * @file
 * Mutable field policy for the disposable test site.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_entity_field_access().
 */
function xinshi_shooting_plan_test_entity_field_access(string $operation, FieldDefinitionInterface $field,
  AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResult {
  return AccessResult::forbiddenIf(\Drupal::state()->get('shooting.denied') === $field->getName() . ':' . $operation)
    ->setCacheMaxAge(0);
}

/** Implements hook_node_access() using the production plan policy. */
function xinshi_shooting_plan_test_node_access($node, $operation, $account) {
  return xinshi_shooting_plan_node_access($node, $operation, $account);
}

/** Implements hook_node_presave() using the production document invariant. */
function xinshi_shooting_plan_test_node_presave($node): void {
  if (\Drupal::state()->get('shooting.fail_save') && $node->bundle() === 'shooting_plan') {
    throw new \RuntimeException('Synthetic storage failure');
  }
  xinshi_shooting_plan_node_presave($node);
}

/** Implements hook_node_delete() using the production sharing cleanup. */
function xinshi_shooting_plan_test_node_delete($node): void {
  xinshi_shooting_plan_node_delete($node);
}
