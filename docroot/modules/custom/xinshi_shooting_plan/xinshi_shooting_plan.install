<?php

/**
 * @file
 * Durable shot associations and the queue outbox for the optional shooting app.
 */

/**
 * Implements hook_schema().
 */
function xinshi_shooting_plan_schema(): array {
  return ['xinshi_shooting_share' => [
    'description' => 'Revocable public links and an explicitly selected document editor.',
    'fields' => [
      'plan_uuid' => ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE],
      'owner_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'token' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'editor_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['plan_uuid'],
    'unique keys' => ['token' => ['token']],
  ], 'xinshi_shooting_sketch' => [
    'description' => 'One immutable image attempt for an authorized storyboard composition.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'request_key' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'plan_uuid' => ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE],
      'shot_id' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'job_uuid' => ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE],
      'task_id' => ['type' => 'varchar_ascii', 'length' => 36, 'not null' => TRUE],
      'prompt' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'model' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'queue_pending' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
    ],
    'primary key' => ['id'],
    'unique keys' => ['request_key' => ['request_key'], 'job_uuid' => ['job_uuid']],
    'indexes' => ['plan_shot' => ['uid', 'plan_uuid', 'shot_id', 'id'],
      'outbox' => ['queue_pending', 'id']],
  ]];
}

/** Adds sharing storage without enabling links or granting site-wide permissions. */
function xinshi_shooting_plan_update_10001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('xinshi_shooting_share')) {
    $schema->createTable('xinshi_shooting_share', xinshi_shooting_plan_schema()['xinshi_shooting_share']);
  }
}
