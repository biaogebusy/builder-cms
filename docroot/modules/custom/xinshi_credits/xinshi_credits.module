<?php

/**
 * @file
 * Lifecycle scheduling and optional frontend configuration for credits.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;

/** Implements hook_xinshi_api_data_alter(). */
function xinshi_credits_xinshi_api_data_alter(&$data, EntityInterface $entity, CacheableMetadata $metadata): void {
  if (!is_array($data) || (\Drupal::request()->query->all()['content'] ?? NULL) !== '/core/base') {
    return;
  }
  $settings = \Drupal::config('xinshi_credits.settings');
  $metadata->addCacheableDependency($settings)->addCacheTags(['config:core.extension']);
  $assembly = \Drupal::getContainer()->getParameter('xinshi_finance.assembly');
  $grants = $assembly['credits'] && $settings->get('grants_enabled') === TRUE;
  $daily = FALSE;
  $welcome = FALSE;
  if ($assembly['rewards']) {
    $rewards = \Drupal::config('xinshi_rewards.settings');
    $metadata->addCacheableDependency($rewards);
    $daily = $grants && $rewards->get('daily_enabled') === TRUE;
    $welcome = $grants && $rewards->get('welcome_enabled') === TRUE;
  }
  // Project only site switches; the credit routes retain all authorization checks.
  $data['credits'] = [
    'enabled' => \Drupal::getContainer()->getParameter('xinshi_site_finance')['credits'],
    'daily_enabled' => $daily,
    'welcome_enabled' => $welcome,
  ];
}

/** Implements hook_cron(). */
function xinshi_credits_cron(): void {
  if (\Drupal::hasService('xinshi_credits.expiry')) \Drupal::service('xinshi_credits.expiry')->process();
}
