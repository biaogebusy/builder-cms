### PROJECT SETTINGS

COMPOSE_PROJECT_NAME=builder-cms
PROJECT_BASE_URL_BASE=builder-cms-base.docker.localhost
PROJECT_BASE_URL_PRO=builder-cms-pro.docker.localhost

DB_NAME_BASE=drupal_base
DB_NAME_PRO=drupal_pro
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=drupal
DB_DRIVER=mysql

### --- MYSQL ----
# 与生产同源(MySQL 8),支持 utf8mb4_0900_ai_ci 排序规则,满足 Drupal 11 要求
# 8.0.28 起为 OL8 基础镜像;8.0.37+ 换 el9 基础,旧版 Docker Desktop 虚拟机无法运行
MYSQL_TAG=8.0.28

#

### --- SOLR ---

SOLR_CONFIG_SET="search_api_solr_8.x-2.3"
#SOLR_CONFIG_SET="search_api_solr_8.x-1.2"
#SOLR_CONFIG_SET="search_api_solr_7.x-1.14"

SOLR_TAG=7.5-3.0.7
